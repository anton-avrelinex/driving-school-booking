{
  "name": "driving-school-booking",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,vue,md,json}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "prepare": "husky",
    "knip": "knip --no-config-hints",
    "knip:production": "knip --production --no-config-hints"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js,mjs,cjs,json,md,yml,yaml,css,html}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "knip": "^6.12.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.7.4",
    "turbo": "^2.8.14",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  }
}
