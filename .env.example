# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=driving_school

# MongoDB
MONGO_INITDB_ROOT_USERNAME=mongo
MONGO_INITDB_ROOT_PASSWORD=mongo
MONGO_INITDB_DATABASE=driving_school_observability

# Redis
REDIS_PASSWORD=redis

# Auth
JWT_SECRET=dev-secret-change-in-production

# Security
# Comma-separated list of allowed CORS origins. Leave unset to disable CORS
# entirely (e.g. when both services sit behind nginx and are same-origin).
# CORS_ORIGIN=http://localhost:5173
