{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    // Extra safety for array and object lookups, but may have false positives.
    "noUncheckedIndexedAccess": true,

    // @vue/tsconfig's dom preset pins lib to ES2020 (matching Vite's default
    // build target) and asks consumers to opt in to newer built-ins. Pull in
    // ES2022.Intl so things like Intl.supportedValuesOf are typed — runtime
    // support is fine on all evergreen browsers and Node 18+.
    "lib": ["ES2020", "ES2022.Intl", "DOM", "DOM.Iterable"],

    "paths": {
      "@/*": ["./src/*"]
    },

    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
